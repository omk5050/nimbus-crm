{
  "name": "nimbus-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise CRM (Single-Link Render Deployment ready) — Nimbus CRM",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "vite build",
    "build:backend": "npm --prefix backend run build",
    "build": "vite build && npm --prefix backend run build",
    "build:render": "npm install && npm --prefix backend install && vite build && npm --prefix backend run db:generate && npm --prefix backend run build",
    "start": "node backend/dist/server.js",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "axios": "^1.7.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router": "^8.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.0.0"
  }
}
