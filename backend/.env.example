# Copy to .env and fill in your values
# Never commit the actual .env file

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://nimbus:nimbus_secret@localhost:5432/nimbus_crm"

# ─── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Email (optional — stubbed to console when not set) ──────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=yourpassword
# EMAIL_FROM="Nimbus CRM <no-reply@example.com>"

# ─── File uploads (optional — stored locally when not set) ───
# S3_BUCKET=nimbus-crm-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
